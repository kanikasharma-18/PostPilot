generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IndicatorValueType {
  COUNT
  DECIMAL
  PERCENTAGE
}

model Division {
  id      String   @id @default(uuid()) @db.Uuid
  code    String   @unique @db.VarChar(50)
  name    String   @db.VarChar(200)

  offices Office[]
}

model Office {
  id         String   @id @default(uuid()) @db.Uuid
  divisionId String   @db.Uuid
  code       String   @db.VarChar(50)
  name       String   @db.VarChar(200)

  division     Division      @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  measurements Measurement[]

  @@unique([divisionId, code])
  @@index([divisionId])
}

model Indicator {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(100)
  name        String             @db.VarChar(200)
  description String
  unit        String             @db.VarChar(50)
  valueType   IndicatorValueType

  measurements Measurement[]
}

model Measurement {
  id          String   @id @default(uuid()) @db.Uuid
  officeId    String   @db.Uuid
  indicatorId String   @db.Uuid
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  value       Decimal  @db.Decimal(20, 4)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  office    Office    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId, periodStart, periodEnd])
  @@index([indicatorId, periodStart, periodEnd])
}
